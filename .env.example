NODE_ENV=production

# Public HTTP port for nginx frontend container
FRONTEND_PORT=80

# Backend API port inside docker network/container
PORT=3001

# Frontend services already call `/api/*`; keep empty to avoid `/api/api/*`
# Example: VITE_API_BASE_URL=
VITE_API_BASE_URL=

# Allowed browser origin for backend CORS
FRONTEND_ORIGIN=http://localhost

# SQLite DB path inside backend container (mounted volume)
SQLITE_DB_PATH=/data/trivia.db

# Admin credentials (validated server-side)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
