{
  "name": "trivia-uruguay-meats",
  "private": true,
  "version": "1.0.0",
  "description": "Kiosk trivia app for Uruguay Lamb",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix backend",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm run dev\" \"npm run dev:api\"",
    "setup:local": "node scripts/bootstrap-local.mjs",
    "build": "tsc -b && vite build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typecheck": "tsc -b --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p electron/tsconfig.preload.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "desktop:rebuild-native": "electron-rebuild --module-dir backend --only better-sqlite3",
    "desktop:compile": "npm run build --prefix backend && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && npm run desktop:rebuild-native",
    "desktop:dev": "npm run desktop:compile && node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:start": "node scripts/desktop-start.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:staff-shortcut-smoke": "node scripts/desktop-staff-shortcut-smoke.mjs",
    "desktop:dist": "npm run desktop:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "kiosk",
    "trivia",
    "react",
    "mui"
  ],
  "author": "Uruguay Meats",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/gfs-didot": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^6.5.0",
    "i18next": "^26.0.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9"
  }
}
